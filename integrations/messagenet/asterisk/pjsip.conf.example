; Template Asterisk PJSIP per MessageNet.
; Sostituisci i valori fra {{...}} prima dell'uso.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[messagenet]
type=registration
transport=transport-udp
outbound_auth=messagenet-auth
server_uri=sip:{{MESSAGENET_SIP_HOST}}:5061
client_uri=sip:{{MESSAGENET_SIP_USER}}@{{MESSAGENET_SIP_HOST}}
contact_user=200
retry_interval=60
forbidden_retry_interval=600
expiration=300

[messagenet-auth]
type=auth
auth_type=userpass
username={{MESSAGENET_SIP_USER}}
password={{MESSAGENET_SIP_PASSWORD}}

[messagenet-aor]
type=aor
contact=sip:{{MESSAGENET_SIP_HOST}}:5061

[messagenet-endpoint]
type=endpoint
transport=transport-udp
context=messagenet-in
disallow=all
allow=alaw
allow=ulaw
outbound_auth=messagenet-auth
aors=messagenet-aor
from_user={{MESSAGENET_SIP_USER}}
from_domain={{MESSAGENET_SIP_HOST}}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[messagenet-identify]
type=identify
endpoint=messagenet-endpoint
match={{MESSAGENET_SIP_HOST}}

